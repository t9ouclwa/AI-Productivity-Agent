# Required
TELEGRAM_BOT_TOKEN=
VAULT_DIR=/absolute/path/to/your/obsidian-vault

# Optional: required for scheduled messages before the bot has learned a chat ID
CHAT_ID=

# Claude CLI
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-haiku-4-5
VOICE_MODEL=claude-sonnet-4-6
CLAUDE_TIMEOUT_SEC=75
CLAUDE_FALLBACK_TIMEOUT_SEC=45
CLAUDE_WEB_TIMEOUT_SEC=120

# Conversation behavior
BATCH_DEBOUNCE_SEC=3
INTERRUPT_DEBOUNCE_SEC=2
CHAT_HISTORY_LIMIT=20
REPLY_BUBBLE_CHARS=3400
MAX_REPLY_BUBBLES=20

# Background jobs
GMAIL_CHECK_INTERVAL_SEC=600
CHECKIN_INTERVAL_SEC=7200
IDLE_CHECKIN_MIN_IDLE_SEC=14400
IDLE_CHECKIN_COOLDOWN_SEC=14400
SPARK_INTERVAL_SEC=1800
SPARK_MIN_IDLE_SEC=1800
SPARK_COOLDOWN_SEC=5400
JOB_MISFIRE_GRACE_SEC=3600
